manifest
{
    mainScript = "main.nf"
    nextflowVersion = ">=25.10.0"
    version = "0.3"
    author = "Ashley Sawle"
    homePage = "https://github.com/crukci-bioinformatics/nf_filter_snvs"
    name = "Filter SNVs using htsjdk-tools pipeline"
}

// Parameter names, types and which are required are declared in the `params`
// block at the top of main.nf. Only the defaults are set here.
// The optional parameters (intervals, vcf_dir, bam_dir) take their null default
// from main.nf and are deliberately not set here: a null assigned in the config
// counts as the parameter having been specified.
params {
    // CSV file specifying the input VCF and BAM files.
    // Must contain an id, vcf and tumour_bam column and optionally a normal_bam
    // column where a matched normal is available.
    inputs_csv = "inputs.csv"

    // Top-level directory containing the output files.
    output_dir = "${launchDir}/filtered_vcfs"

    // Filter names and expressions provided to GATK VariantFiltration
    snv_filters = """
        --filter-name VariantAlleleCount \
        --filter-expression 'VariantAlleleCount < 3' \
        --filter-name VariantAlleleCountControl \
        --filter-expression 'VariantAlleleCountControl > 1' \
        --filter-name VariantMapQualMedian \
        --filter-expression 'VariantMapQualMedian < 40.0' \
        --filter-name MapQualDiffMedian \
        --filter-expression 'MapQualDiffMedian < -5.0 || MapQualDiffMedian > 5.0' \
        --filter-name LowMapQual \
        --filter-expression 'LowMapQual > 0.05' \
        --filter-name VariantBaseQualMedian \
        --filter-expression 'VariantBaseQualMedian < 25.0' \
    """

    // If the output is from sarek the vcfs are in subdirectories named after the
    // sample:
    //   <vcf_dir>/<id>/<vcf>
    sarek_output = false
}

// Destination for the files declared in the `output` block of main.nf.
outputDir = params.output_dir

process {
    container = 'crukcibioinformatics/filter-snvs:latest'

    errorStrategy = {
        task.exitStatus in ([ 104, 134 ] + (137..140)) ? 'retry' : 'finish'
    }

    cpus   = 1
    memory = 1.GB
    time   = '1h'

    withName: getSampleNames {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { 1.GB * task.attempt }
    }

    withName: selectRest {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { 2.GB * task.attempt }
    }

    withName: calculateSNVMetrics {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { 24.GB * task.attempt }
    }

    withName: applySnvFilters {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { 2.GB * task.attempt }
    }

    withName: vcfToMaf {
        errorStrategy = 'retry'
        maxRetries    = 3
        memory        = { 4.GB * task.attempt }
    }
}

singularity {
    autoMounts = true
    runOptions = "-B /mnt"
}

profiles {
    standard
    {
        process.executor = "local"
        executor
        {
            cpus = 4
            memory = 8.GB
        }
    }

    bigserver
    {
        process.executor = "local"
        executor
        {
            cpus = 50
            memory = 128.GB
        }
    }

    cluster {
        process.executor = "slurm"
        executor {
            queueSize = 200
            pollInterval = '30 sec'
            jobName = { "'${task.name}'" }
        }
        singularity.enabled = true
    }

    epyc {
        process.executor = "slurm"
        process.queue = 'epyc'
        executor {
            queueSize = 200
            pollInterval = '30 sec'
            jobName = { "'${task.name}'" }
        }
        singularity.enabled = true 
        conda.enabled = false  
        conda.useMamba = false
    }

}

